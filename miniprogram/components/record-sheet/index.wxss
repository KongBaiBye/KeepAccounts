.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(31, 42, 55, 0.42);
  opacity: 0;
  transition: opacity 0.22s ease;
}

.mask.on {
  opacity: 1;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  height: 86vh;
  display: flex;
  flex-direction: column;
  background: #F6F4F1;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.24s ease;
  overflow: hidden;
}

.sheet.on {
  transform: translateY(0);
}

.handle {
  width: 72rpx;
  height: 8rpx;
  margin: 16rpx auto 4rpx;
  border-radius: 8rpx;
  background: #E7E1D8;
  flex: none;
}

.main {
  flex: none;
  padding: 12rpx 32rpx 8rpx;
}

.types {
  display: flex;
  width: 280rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #E7E1D8;
}

.type {
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  text-align: center;
  line-height: 64rpx;
  color: #8A8178;
  font-size: 26rpx;
}

.type.on {
  background: #ffffff;
  color: #1F2A37;
  font-weight: 600;
}

.amount {
  margin: 28rpx 0 12rpx;
  font-size: 76rpx;
  font-weight: 600;
  line-height: 1.1;
  font-family: "DIN Alternate", "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

.meta {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.date,
.note {
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
}

.date {
  flex: none;
  margin-right: 16rpx;
}

.note {
  flex: 1;
}

.placeholder {
  color: #8A8178;
}

.tag-scroll {
  width: 100%;
  height: 88rpx;
  margin-bottom: 8rpx;
  white-space: nowrap;
  flex: none;
}

.chip {
  display: inline-flex;
  align-items: center;
  flex: none;
  height: 64rpx;
  margin-right: 16rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 26rpx;
}

.chip:first-child {
  margin-left: 32rpx;
}

.chip:last-child {
  margin-right: 32rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 10rpx;
  border-radius: 14rpx;
}

.dot.big {
  width: 20rpx;
  height: 20rpx;
}

.empty-tags {
  margin-top: 20rpx;
  color: #8A8178;
  font-size: 26rpx;
}

.link {
  margin-left: 12rpx;
  color: #1F2A37;
}

.keypad {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: auto;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #EFEBE6;
  flex: none;
}

.key {
  height: 92rpx;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
}

.key-del {
  grid-column: 4;
  grid-row: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: #8A8178;
}

.key-zero {
  grid-column: span 2;
}

.key-ok {
  grid-column: 4;
  grid-row: 2 / span 3;
  height: auto;
  background: #1F2A37;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
}

.key-ok.off {
  opacity: 0.35;
}
