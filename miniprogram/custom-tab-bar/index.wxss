.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #F6F4F1;
  border-top: 1rpx solid #E7E1D8;
  box-sizing: border-box;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8A8178;
  font-size: 22rpx;
}

.tab.on {
  color: #1F2A37;
  font-weight: 600;
}

.icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
  opacity: 0.38;
}

.tab.on .icon {
  opacity: 1;
}
