<view class="tab-bar" hidden="{{hidden}}">
  <view
    class="tab {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="onSwitch"
  >
    <image class="icon" src="{{item.icon}}" mode="aspectFit"></image>
    <text>{{item.text}}</text>
  </view>
</view>
