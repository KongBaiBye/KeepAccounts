.head {
  display: flex;
  align-items: center;
  margin: 8rpx 8rpx 28rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.span {
  margin-left: 16rpx;
  font-size: 24rpx;
}

.group {
  margin-top: 28rpx;
}

.group-head {
  display: flex;
  justify-content: space-between;
  margin: 0 8rpx 16rpx;
  font-size: 24rpx;
}

.list {
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.row + .row {
  border-top: 1rpx solid #E7E1D8;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.record-name {
  font-size: 30rpx;
}

.note {
  margin-top: 6rpx;
  color: #8A8178;
  font-size: 24rpx;
}

.amount {
  font-size: 32rpx;
  font-weight: 600;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
}
