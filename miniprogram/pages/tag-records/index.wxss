.head {
  display: flex;
  align-items: center;
  margin: 8rpx 8rpx 20rpx;
}

.modes {
  width: 100%;
  white-space: nowrap;
}

.mode-track {
  display: inline-flex;
}

.mode {
  height: 60rpx;
  margin-right: 12rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #8A8178;
  font-size: 26rpx;
  line-height: 60rpx;
}

.mode.on {
  background: #1F2A37;
  color: #ffffff;
}

.range-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.arrow {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #ffffff;
  text-align: center;
  line-height: 68rpx;
  font-size: 44rpx;
  color: #1F2A37;
}

.range-label {
  font-size: 32rpx;
  font-weight: 600;
}

.range-label.alone {
  flex: 1;
  text-align: center;
}

.ask {
  padding: 48rpx 0 24rpx;
  text-align: center;
}

.ask-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.ask-btn {
  width: 280rpx;
  margin: 28rpx auto 0;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  background: rgba(31, 42, 55, 0.28);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #F6F4F1;
}

.sheet-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.range-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  margin-bottom: 16rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.field-label {
  color: #8A8178;
  font-size: 28rpx;
}

.date-value {
  font-size: 30rpx;
  font-weight: 600;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
}

.total-label {
  color: #8A8178;
  font-size: 28rpx;
}

.total-value {
  font-size: 40rpx;
  font-weight: 600;
}

.group {
  margin-top: 28rpx;
}

.group-head {
  display: flex;
  justify-content: space-between;
  margin: 0 8rpx 16rpx;
  font-size: 24rpx;
}

.list {
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.row + .row {
  border-top: 1rpx solid #E7E1D8;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.record-name {
  font-size: 30rpx;
}

.note {
  margin-top: 6rpx;
  color: #8A8178;
  font-size: 24rpx;
}

.amount {
  font-size: 32rpx;
  font-weight: 600;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
}
