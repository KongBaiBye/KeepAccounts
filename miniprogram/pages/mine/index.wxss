.profile-form {
  display: block;
}

.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx 40rpx;
}

.avatar {
  width: 160rpx !important;
  height: 160rpx !important;
  min-width: 160rpx !important;
  max-width: 160rpx !important;
  padding: 0 !important;
  border-radius: 80rpx !important;
  overflow: hidden;
  background: #E7E1D8;
  border: 6rpx solid #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(31, 42, 55, 0.12);
  line-height: 0;
}

.avatar image {
  width: 160rpx;
  height: 160rpx;
  display: block;
}

.nick {
  width: 100%;
  height: 64rpx;
  margin-top: 28rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2A37;
}

.hint {
  margin-top: 4rpx;
  font-size: 24rpx;
}

.save {
  width: 100%;
  margin-top: 32rpx;
}

.menu {
  margin-top: 24rpx;
  overflow: hidden;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 128rpx;
  padding: 24rpx 28rpx;
}

.menu-row + .menu-row {
  border-top: 1rpx solid #F0EBE4;
}

.menu-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.menu-mark {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: #1F2A37;
  color: #F6F4F1;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-copy {
  display: flex;
  flex-direction: column;
}

.menu-title {
  font-size: 30rpx;
  color: #1F2A37;
}

.menu-desc {
  margin-top: 6rpx;
  color: #8A8178;
  font-size: 22rpx;
}

.chevron {
  color: #B7AFA6;
  font-size: 40rpx;
  line-height: 1;
}

.logout {
  margin-top: 24rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #E85D4C;
  font-size: 30rpx;
}
