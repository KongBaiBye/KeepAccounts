<view class="boot" wx:if="{{!ready}}">正在打开</view>
<view class="screen" wx:else>
  <view class="top">
    <button class="btn new" bindtap="create">新建标签</button>
  </view>

  <view class="section">
    <text class="section-title">支出</text>
    <view class="empty-line muted" wx:if="{{!expenseTags.length}}">还没有标签</view>
    <view class="card" wx:else>
      <view
        class="swipe {{item.archived ? 'restore' : ''}}"
        wx:for="{{expenseTags}}"
        wx:key="_id"
        data-id="{{item._id}}"
        data-type="expense"
        data-index="{{index}}"
        bindtouchstart="onSwipeStart"
        bindtouchmove="onSwipeMove"
        bindtouchend="onSwipeEnd"
      >
        <view class="action" data-id="{{item._id}}" data-disabled="{{item.archived ? 1 : 0}}" catchtap="onToggle">{{item.archived ? '恢复' : '停用'}}</view>
        <view class="row {{item.archived ? 'off' : ''}} {{item.depth ? 'child' : ''}}" style="transform: translateX({{item.offset}}px);" data-id="{{item._id}}" data-type="expense" bindtap="openTag">
          <view class="dot" style="background: {{item.color}};"></view>
          <tag-icon name="{{item.icon}}" size="40"></tag-icon>
          <text class="name">{{item.name}}</text>
          <view
            wx:if="{{!item.archived}}"
            class="grip"
            data-type="expense"
            data-index="{{index}}"
            catchtouchstart="onDragStart"
            catchtouchmove="onDragMove"
            catchtouchend="onDragEnd"
          ></view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">收入</text>
    <view class="empty-line muted" wx:if="{{!incomeTags.length}}">还没有标签</view>
    <view class="card" wx:else>
      <view
        class="swipe {{item.archived ? 'restore' : ''}}"
        wx:for="{{incomeTags}}"
        wx:key="_id"
        data-id="{{item._id}}"
        data-type="income"
        data-index="{{index}}"
        bindtouchstart="onSwipeStart"
        bindtouchmove="onSwipeMove"
        bindtouchend="onSwipeEnd"
      >
        <view class="action" data-id="{{item._id}}" data-disabled="{{item.archived ? 1 : 0}}" catchtap="onToggle">{{item.archived ? '恢复' : '停用'}}</view>
        <view class="row {{item.archived ? 'off' : ''}} {{item.depth ? 'child' : ''}}" style="transform: translateX({{item.offset}}px);" data-id="{{item._id}}" data-type="income" bindtap="openTag">
          <view class="dot" style="background: {{item.color}};"></view>
          <tag-icon name="{{item.icon}}" size="40"></tag-icon>
          <text class="name">{{item.name}}</text>
          <view
            wx:if="{{!item.archived}}"
            class="grip"
            data-type="income"
            data-index="{{index}}"
            catchtouchstart="onDragStart"
            catchtouchmove="onDragMove"
            catchtouchend="onDragEnd"
          ></view>
        </view>
      </view>
    </view>
  </view>
</view>
