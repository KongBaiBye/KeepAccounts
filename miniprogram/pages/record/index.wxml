<view class="record" wx:if="{{ready}}">
  <scroll-view class="main" scroll-y>
    <view class="types">
      <view class="type {{type === 'expense' ? 'on' : ''}}" data-type="expense" bindtap="switchType">支出</view>
      <view class="type {{type === 'income' ? 'on' : ''}}" data-type="income" bindtap="switchType">收入</view>
    </view>
    <view class="amount num">{{amountText}}</view>
    <view class="meta">
      <picker mode="date" value="{{date}}" bindchange="onDate">
        <view class="date">{{dateLabel}}</view>
      </picker>
      <input
        class="note"
        placeholder="备注"
        placeholder-class="placeholder"
        maxlength="40"
        value="{{note}}"
        bindinput="onNote"
      />
    </view>
    <scroll-view class="tag-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="tag-track">
        <view
          class="chip {{tagId === item._id ? 'on' : ''}}"
          wx:for="{{tags}}"
          wx:key="_id"
          data-id="{{item._id}}"
          style="{{tagId === item._id ? 'background:' + item.tint : ''}}"
          bindtap="pickTag"
        >
          <view class="dot {{tagId === item._id ? 'big' : ''}}" style="background: {{item.color}};"></view>
          <text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="empty-tags" wx:if="{{emptyTags}}">
      <text>还没有可用标签</text>
      <text class="link" bindtap="goTags">去添加</text>
    </view>
    <view class="delete" wx:if="{{id}}" bindtap="onDelete">删除这笔账单</view>
  </scroll-view>

  <view class="keypad">
    <view class="key" data-key="1" bindtap="onKey">1</view>
    <view class="key" data-key="2" bindtap="onKey">2</view>
    <view class="key" data-key="3" bindtap="onKey">3</view>
    <view class="key key-del" data-key="del" bindtap="onKey">删除</view>
    <view class="key" data-key="4" bindtap="onKey">4</view>
    <view class="key" data-key="5" bindtap="onKey">5</view>
    <view class="key" data-key="6" bindtap="onKey">6</view>
    <view class="key" data-key="7" bindtap="onKey">7</view>
    <view class="key" data-key="8" bindtap="onKey">8</view>
    <view class="key" data-key="9" bindtap="onKey">9</view>
    <view class="key" data-key="." bindtap="onKey">.</view>
    <view class="key key-zero" data-key="0" bindtap="onKey">0</view>
    <view class="key key-ok {{canSave ? '' : 'off'}}" bindtap="onSave">完成</view>
  </view>
</view>
