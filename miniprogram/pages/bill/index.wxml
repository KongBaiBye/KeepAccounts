<view class="boot" wx:if="{{!ready}}">正在打开</view>
<view class="screen" wx:else>
  <view class="card summary">
    <text class="month">{{monthLabel}}</text>
    <view class="metrics">
      <view class="metric">
        <text class="label">支出</text>
        <text class="value expense num">{{expenseText}}</text>
      </view>
      <view class="metric">
        <text class="label">收入</text>
        <text class="value income num">{{incomeText}}</text>
      </view>
      <view class="metric balance">
        <text class="label">结余</text>
        <text class="value num">{{balanceText}}</text>
      </view>
    </view>
  </view>

  <block wx:if="{{loaded && groups.length}}">
    <view class="group" wx:for="{{groups}}" wx:key="dayKey">
      <view class="group-head">
        <text>{{item.label}}</text>
        <text class="muted">{{item.subText}}</text>
      </view>
      <view class="card list">
        <view
          class="row"
          wx:for="{{item.records}}"
          wx:for-item="record"
          wx:key="_id"
          data-id="{{record._id}}"
          bindtap="openRecord"
        >
          <view class="dot" style="background: {{record.tagColor}};"></view>
          <view class="info">
            <text class="name">{{record.title}}</text>
            <text class="note" wx:if="{{record.note}}">{{record.note}}</text>
          </view>
          <text class="amount num {{record.type}}">{{record.amountText}}</text>
        </view>
      </view>
    </view>
    <view class="more muted" wx:if="{{!hasMore}}">没有更多了</view>
  </block>

  <view class="empty" wx:elif="{{loaded}}">
    <text class="empty-title">还没有账单</text>
    <text class="empty-desc">记下第一笔，后面的统计就有数了。</text>
    <button class="btn" bindtap="create">记一笔</button>
  </view>

  <view class="fab" bindtap="create">记一笔</view>
  <record-sheet wx:if="{{sheetOpen}}" bindclose="closeSheet" bindsaved="onRecordSaved"></record-sheet>
</view>
