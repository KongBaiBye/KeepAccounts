.summary {
  padding: 36rpx 32rpx 32rpx;
}

.month {
  color: #8A8178;
  font-size: 24rpx;
}

.metrics {
  display: flex;
  align-items: flex-end;
  margin-top: 28rpx;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.balance {
  flex: 1.25;
}

.label {
  color: #8A8178;
  font-size: 22rpx;
}

.value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.balance .value {
  font-size: 52rpx;
  color: #1F2A37;
}

.group {
  margin-top: 36rpx;
}

.group-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 0 8rpx 16rpx;
  font-size: 24rpx;
}

.list {
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
}

.row + .row {
  border-top: 1rpx solid #E7E1D8;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex: none;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 30rpx;
}

.note {
  margin-top: 6rpx;
  color: #8A8178;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.amount {
  margin-left: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.more,
.empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.empty-title {
  font-size: 34rpx;
}

.empty-desc {
  margin: 12rpx 0 36rpx;
  color: #8A8178;
  font-size: 26rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(144rpx + env(safe-area-inset-bottom));
  z-index: 20;
  height: 96rpx;
  padding: 0 36rpx;
  border-radius: 48rpx;
  background: #1F2A37;
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(31, 42, 55, 0.16);
}
