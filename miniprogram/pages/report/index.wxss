.toolbar {
  position: sticky;
  top: 0;
  z-index: 5;
  margin: 0 -32rpx;
  padding: 8rpx 32rpx 20rpx;
  background: #F6F4F1;
}

.modes {
  width: 100%;
  white-space: nowrap;
}

.mode-track {
  display: inline-flex;
  gap: 12rpx;
}

.mode {
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #8A8178;
  font-size: 26rpx;
  line-height: 60rpx;
}

.mode.on {
  background: #1F2A37;
  color: #ffffff;
}

.range-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.arrow {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #ffffff;
  text-align: center;
  line-height: 68rpx;
  font-size: 44rpx;
  color: #1F2A37;
}

.range-label {
  font-size: 32rpx;
  font-weight: 600;
}

.cycle {
  margin-top: 12rpx;
  color: #8A8178;
  font-size: 24rpx;
  text-align: center;
}

.summary {
  padding: 32rpx 28rpx;
}

.metrics {
  display: flex;
  align-items: flex-start;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.balance {
  flex: 1.2;
}

.label {
  color: #8A8178;
  font-size: 22rpx;
}

.value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.balance .value {
  font-size: 44rpx;
  color: #1F2A37;
}

.delta {
  margin-top: 8rpx;
  color: #8A8178;
  font-size: 20rpx;
}

.delta.up {
  color: #1F8A70;
}

.delta.down {
  color: #E85D4C;
}

.ask,
.empty-block {
  padding: 80rpx 0;
  text-align: center;
  color: #8A8178;
}

.ask {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ask-title {
  margin-bottom: 12rpx;
  color: #1F2A37;
  font-size: 34rpx;
}

.ask-btn {
  margin-top: 32rpx;
}

.group-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 36rpx;
}

.group-switch .section-title {
  margin: 0 8rpx;
}

.switches {
  display: flex;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #E7E1D8;
}

.switch {
  min-width: 96rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #8A8178;
  font-size: 24rpx;
  line-height: 52rpx;
  text-align: center;
}

.switch.on {
  background: #ffffff;
  color: #1F2A37;
  font-weight: 600;
}

.section {
  margin-top: 36rpx;
}

.section-head,
.section-title {
  display: block;
  margin: 0 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-head .section-title {
  margin: 0;
}

.legend {
  display: flex;
  gap: 20rpx;
  color: #8A8178;
  font-size: 22rpx;
  font-weight: 400;
}

.swatch {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 12rpx;
}

.portion {
  padding: 12rpx 28rpx 20rpx;
}

.bar-row {
  padding: 18rpx 0;
}

.bar-meta {
  display: flex;
  align-items: center;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
}

.bar-name {
  flex: 1;
}

.bar-amount {
  font-size: 26rpx;
}

.track {
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 12rpx;
  background: #F6F4F1;
  overflow: hidden;
}

.fill,
.expense-bg {
  background: #E85D4C;
}

.income-bg {
  background: #1F8A70;
}

.fill {
  height: 100%;
  border-radius: 12rpx;
}

.trend-card {
  padding: 28rpx 12rpx 16rpx;
}

.trend {
  display: inline-flex;
  align-items: flex-end;
  min-width: 100%;
  height: 260rpx;
  padding: 0 8rpx;
}

.col {
  min-width: 48rpx;
  padding: 0 10rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.plot {
  height: 210rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-amount {
  margin-bottom: 6rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.bar {
  width: 12rpx;
  border-radius: 8rpx 8rpx 0 0;
}

.col-label {
  margin-top: 10rpx;
  color: #8A8178;
  font-size: 20rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  background: rgba(31, 42, 55, 0.28);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #F6F4F1;
}

.sheet-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.day {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #ffffff;
  text-align: center;
  line-height: 80rpx;
  font-size: 28rpx;
}

.day.on {
  background: #1F2A37;
  color: #ffffff;
}
